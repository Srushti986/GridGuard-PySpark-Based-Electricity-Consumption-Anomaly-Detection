# Copy to .env and edit. Real environment variables take precedence over this file.
# Never commit .env (it is git-ignored). No secrets are needed for this project.

# --- data & outputs (relative paths are resolved from the project root)
GRIDGUARD_DATASET_PATH=data/household_power_consumption.txt
GRIDGUARD_OUTPUT_DIR=outputs

# --- HDFS (leave disabled for standalone / Colab Mode B)
GRIDGUARD_HDFS_ENABLED=false
GRIDGUARD_HDFS_URI=hdfs://localhost:8020
GRIDGUARD_HDFS_BASE_DIR=/gridguard
GRIDGUARD_HDFS_USER=hadoop
# Read-only HTTP access used by the Streamlit dashboard
GRIDGUARD_WEBHDFS_URL=http://localhost:9870

# --- anomaly detection
GRIDGUARD_Z_THRESHOLD=3.0
GRIDGUARD_BASELINE_DAYS=14
GRIDGUARD_MIN_HISTORY=5
GRIDGUARD_MIN_VALID_MINUTES=30
# true = compare weekdays with weekdays and weekends with weekends (needs a longer baseline)
GRIDGUARD_BASELINE_BY_DAY_TYPE=false

# --- Spark
GRIDGUARD_SPARK_APP_NAME=GridGuard
GRIDGUARD_SPARK_MASTER=local[*]
GRIDGUARD_SPARK_DRIVER_MEMORY=2g
